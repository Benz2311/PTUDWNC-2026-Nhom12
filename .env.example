# =============================================================================
# CULINARY BLOG - CẤU HÌNH BIẾN MÔI TRƯỜNG MẪU (SRS v1.2.0)
# Sao chép tệp này thành .env để tùy chỉnh môi trường: cp .env.example .env
# =============================================================================

# PostgreSQL 16
POSTGRES_DB=culinaryblog
POSTGRES_USER=culinaryadmin
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_PORT=55432

# Redis 7 (Cache & Rate Limiting)
REDIS_PORT=6379
REDIS_PASSWORD=replace_with_random_redis_secret

# MinIO S3-Compatible Object Storage
MINIO_ROOT_USER=replace_with_storage_user
MINIO_ROOT_PASSWORD=replace_with_random_storage_secret
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_DEFAULT_BUCKET=culinaryblog
MINIO_IMAGE=cgr.dev/chainguard/minio:latest

# Backend API (.NET 10 Minimal API)
API_PORT=5000
DATABASE_AUTO_MIGRATE=false
JWT_SECRET_KEY=CHANGE_ME_use_at_least_32_character_secret_key!!

# Google OAuth 2.0 (FR-AUTH-003)
# Đăng ký tại https://console.cloud.google.com/apis/credentials
# Cấu hình Authorized JavaScript origins: http://localhost:8088, http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Frontend (Next.js App Router)
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:5000

# Nginx Reverse Proxy & Load Balancer
NGINX_PORT=80
# Optional override for links sent by email, e.g. https://food.example.com
# PUBLIC_ORIGIN=


# Observability (Chỉ dùng cho Development - SRS 6.5)
SEQ_PORT=5341
MAILHOG_UI_PORT=8025
MAILHOG_SMTP_PORT=1025

# Production only; placeholders are NOT deployment credentials.
PUBLIC_ORIGIN=https://replace-with-your-domain.example
TLS_CERT_DIR=./infrastructure/nginx/ssl
SIXLABORS_LICENSE_FILE=./private/sixlabors.lic

# Test isolation: override ALL names and ports in a private .env.docker-test.
CONTAINER_PREFIX=culinaryblog
VOLUME_PREFIX=culinaryblog
NETWORK_NAME=culinaryblog_network

# Keep development and production image tags separate.
IMAGE_TAG=dev
PRODUCTION_IMAGE_TAG=prod
