{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=culinaryblog;Username=culinaryadmin;Password=123456",
    "Redis": "localhost:6379"
  },

  "Jwt": {
    "SecretKey": "CHANGE_ME_use_at_least_32_character_secret_key!!",
    "Issuer": "CulinaryBlog.Api",
    "Audience": "CulinaryBlog.Client",
    "ExpiryMinutes": 60
  },

  "Storage": {
    "ServiceUrl": "http://localhost:9000",
    "AccessKey": "minioadmin",
    "SecretKey": "minioadmin",
    "Region": "us-east-1",
    "DefaultBucket": "culinaryblog"
  },

  "Email": {
    "Host": "localhost",
    "Port": 1025,
    "UseSsl": false,
    "UserName": "",
    "Password": "",
    "SenderEmail": "noreply@culinaryblog.local",
    "SenderName": "CulinaryBlog"
  },

  "OpenTelemetry": {
    "ServiceName": "CulinaryBlog.Api",
    "Endpoint": "http://localhost:4317"
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/culinaryblog-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30
        }
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://localhost:5341"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },

  "AllowedHosts": "*"
}
