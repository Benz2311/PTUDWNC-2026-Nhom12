{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=CulinaryBlog_Test;User Id=postgres;Password=postgres;",
    "Redis": ""
  },
  "JwtSettings": {
    "SecretKey": "TestSecretKeyForIntegrationTestsOnly12345678901234567890",
    "Issuer": "CulinaryBlog.Test",
    "Audience": "CulinaryBlog.Test",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "EmailSettings": {
    "SmtpServer": "localhost",
    "SmtpPort": 25,
    "SmtpUsername": "",
    "SmtpPassword": "",
    "FromEmail": "test@culinaryblog.com",
    "FromName": "CulinaryBlog Test"
  },
  "RateLimiting": {
    "Auth": { "PermitLimit": 1000 },
    "Refresh": { "PermitLimit": 1000 },
    "Api": { "PermitLimit": 10000 },
    "Upload": { "PermitLimit": 1000 }
  },
  "MinioSettings": {
    "Endpoint": "localhost:9000",
    "AccessKey": "minioadmin",
    "SecretKey": "minioadmin",
    "BucketName": "culinaryblog-test",
    "UseSSL": false
  },
  "Serilog": {
    "Using": ["Serilog.Sinks.Console"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ],
    "Enrich": ["FromLogContext"]
  }
}